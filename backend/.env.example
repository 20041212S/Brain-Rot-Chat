# Provider 1: Groq (Recommended for ultra-fast generation)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
# gpt-oss-120b is heavily safety-tuned and refuses profanity.
# qwen3.8-27b follows the uncensored persona much better.
LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_TOKENS=800

# Provider 2: Google Gemini (via OpenAI compatibility endpoint)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-3.5-flash
# LLM_MAX_TOKENS=800
# LLM_REASONING_EFFORT=low

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
